 #===============================================================================
-find_package(Eigen3 3.0.5 QUIET CONFIG)
+# RoboStack: do not pin a minimum version here. Eigen >= 5 ships a
+# SameMajorVersion config-version file, so requesting 3.0.5 rejects the conda
+# Eigen and silently falls back to a system-wide Eigen 3.x if one exists.
+find_package(Eigen3 QUIET CONFIG)
 
 # If Eigen3Config.cmake is not found, use the FindEigen3.cmake module
 if(NOT Eigen3_FOUND)
-  find_package(Eigen3 3.0.5 QUIET MODULE)
+  find_package(Eigen3 QUIET MODULE)
   set(Eigen3_FOUND ON)
 endif()
 
